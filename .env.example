# Panvas Environment Variables Template
# Copy this file to .env and fill in your values for local development.
# Do NOT commit your actual .env file.

# Supabase Configuration (Optional for Marketing site, Required for App)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog Analytics (Required for feature tracking)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Deployment Modes
# Set to 'true' to disable the workspace application and route everything to the Private Beta page.
VITE_MARKETING_ONLY=true
